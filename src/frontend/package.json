{
  "name": "trivyoperator.dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run prebuild && ng serve",
    "build": "ng build",
    "build:sme": "ng build --source-map=true --named-chunks==true && source-map-explorer dist/**/*.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prebuild": "node build/preBuild.js",
    "update-endpoints:local": "curl -L http://localhost:5032/swagger/v1/swagger.yaml -o backend-api.yaml",
    "prettier:cli": "prettier '**/*.{css,scss,md,yml,json,js,ts,xml,html}'",
    "prettier:check": "npm run prettier:cli -- --check",
    "prettier:fix": "npm run prettier:cli -- --write",
    "eslint:cli": "eslint",
    "eslint:check": "npm run eslint:cli",
    "eslint:fix": "npm run eslint:cli -- --fix",
    "lint": "npm run eslint:check && npm run prettier:check",
    "lint:fix": "npm run eslint:fix && npm run prettier:fix"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@angular/router": "21.2.26",
    "@microsoft/signalr": "10.0.11",
    "@primeuix/themes": "2.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "cytoscape": "3.33.1",
    "cytoscape-fcose": "2.2.0",
    "ngx-markdown": "21.3.0",
    "postcss": "8.5.28",
    "primeicons": "7.0.0",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.30",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@types/cytoscape": "3.31.0",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/jasmine": "5.1.15",
    "@types/node": "24.13.6",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "baseline-browser-mapping": "2.11.26",
    "eslint": "9.39.5",
    "eslint-plugin-html": "8.2.1",
    "jasmine-core": "5.13.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "ng-openapi-gen": "1.1.0",
    "prettier": "3.9.9",
    "prettier-plugin-multiline-arrays": "4.1.11",
    "prettier-plugin-organize-attributes": "1.0.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "source-map-explorer": "2.5.3",
    "typescript": "5.9.3"
  }
}
