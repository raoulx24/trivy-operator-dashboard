{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MainAppPort": 8900,
  "Kubernetes": {
    "KubeConfigFileName": "",
    "UseDefaultContext": true,
    "NamespaceList": "",
    "TrivyUseClusterComplianceReport": true,
    "TrivyUseClusterInfraAssessmentReport": true,
    "TrivyUseClusterRbacAssessmentReport": true,
    "TrivyUseClusterSbomReport": true,
    "TrivyUseClusterVulnerabilityReport": true,
    "TrivyUseConfigAuditReport": true,
    "TrivyUseExposedSecretReport": true,
    "TrivyUseInfraAssessmentReport": true,
    "TrivyUseRbacAssessmentReport": true,
    "TrivyUseSbomReport": true,
    "TrivyUseVulnerabilityReport": true
  },
  "FileExport": {
    "TempFolder": null
  },
  "Queues": {
    "Capacity": 5000
  },
  "Watchers": {
    "WatchTimeoutInSeconds": 600,
    "FilterWatchersWithNoActivity": true
  },
  "FileRepository": {
    "BasePath": "",
    "ClusterComplianceReportCrSubpath": "",
    "ClusterInfraAssessmentReportCrSubpath": "",
    "ClusterRbacAssessmentReportCrSubpath": "",
    "ClusterSbomReportCrSubpath": "cluster_sbom_reports",
    "ClusterVulnerabilityReportCrSubpath": "cluster_vulnerability_reports",
    "ConfigAuditReportCrSubpath": "",
    "ExposedSecretReportCrSubpath": "secret_reports",
    "InfraAssessmentReportCrSubpath": "",
    "RbacAssessmentReportCrSubpath": "",
    "SbomReportCrSubpath": "sbom_reports",
    "VulnerabilityReportCrSubpath": "vulnerability_reports"
  },
  "History": {
    "Enabled": true,
    "Retention": {
      "RunIntervalInMinutes": 360,
      "KeepDays": 14,
      "KeepLast": 2
    },
    "DistributedCache": {
      "ConnectionString": "localhost:6379,ssl=False,abortConnect=False",
      "RetryOptions": {
        "MaxRetries": 5,
        "InitialDelay": "50ms",
        "MaxDelay": "1s"
      }
    }
  }, 
  "GitHub": {
    "BaseTrivyDashboardRepoUrl": "https://api.github.com/repos/raoulx24/trivy-operator-dashboard",
    "BaseTrivyOperatorRepoUrl": "https://api.github.com/repos/aquasecurity/trivy-operator",
    "ServerCheckForUpdates": true,
    "CheckForUpdatesIntervalInMinutes": 360
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtelEndpoint": "",
    "ConsoleEnabled": false,
    "AspNetCoreInstrumentationEnabled": true,
    "RuntimeInstrumentationEnabled": true,
    "OtelProtocol": "grpc",
    "HistogramBoundsInMs": [
      200,
      500,
      1000,
      5000
    ],
    "PrometheusExporterPort": 8901
  }
}
