{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MainAppPort": 8900,
  "Kubernetes": {
    "KubeConfigFileName": "",
    "UseDefaultContext": true,
    "NamespaceList": ""
  },
  "EnabledTrivyReports":{
    "ClusterComplianceReport": false,
    "ClusterInfraAssessmentReport": false,
    "ClusterRbacAssessmentReport": true,
    "ClusterSbomReport": false,
    "ClusterVulnerabilityReport": false,
    "ConfigAuditReport": false,
    "ExposedSecretReport": false,
    "InfraAssessmentReport": false,
    "RbacAssessmentReport": true,
    "SbomReport": false,
    "VulnerabilityReport": true
  },
  "FileExport": {
    "TempFolder": null
  },
  "Queues": {
    "Capacity": 5000
  },
  "Watchers": {
    "WatchTimeoutInSeconds": 600,
    "FilterWatchersWithNoActivity": true
  },
  "FileRepository": {
    "BasePath": "",
    "ClusterComplianceReportCrSubpath": "",
    "ClusterInfraAssessmentReportCrSubpath": "",
    "ClusterRbacAssessmentReportCrSubpath": "",
    "ClusterSbomReportCrSubpath": "cluster_sbom_reports",
    "ClusterVulnerabilityReportCrSubpath": "cluster_vulnerability_reports",
    "ConfigAuditReportCrSubpath": "",
    "ExposedSecretReportCrSubpath": "secret_reports",
    "InfraAssessmentReportCrSubpath": "",
    "RbacAssessmentReportCrSubpath": "",
    "SbomReportCrSubpath": "sbom_reports",
    "VulnerabilityReportCrSubpath": "vulnerability_reports"
  },
  "History": {
    "Enabled": true,
    "Retention": {
      "RunIntervalInMinutes": 30,
      "KeepDays": 14,
      "KeepLast": 2
    },
    "DistributedCache": {
      "ConnectionString": "192.168.85.3:6379,ssl=False,abortConnect=False",
      "RetryOptions": {
        "MaxRetries": 5,
        "InitialDelay": "50ms",
        "MaxDelay": "1s"
      }
    }
  },
  "InMemoryCache": {
    "ExpireInMinutes": 10
  },
  "GitHub": {
    "BaseTrivyDashboardRepoUrl": "https://api.github.com/repos/raoulx24/trivy-operator-dashboard",
    "BaseTrivyOperatorRepoUrl": "https://api.github.com/repos/aquasecurity/trivy-operator",
    "ServerCheckForUpdates": true,
    "CheckForUpdatesIntervalInMinutes": 360
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtelEndpoint": "",
    "ConsoleEnabled": false,
    "AspNetCoreInstrumentationEnabled": true,
    "RuntimeInstrumentationEnabled": true,
    "OtelProtocol": "grpc",
    "HistogramBoundsInMs": [
      200,
      500,
      1000,
      5000
    ],
    "PrometheusExporterPort": 8901
  }
}
