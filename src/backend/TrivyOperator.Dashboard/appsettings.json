{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "MainAppPort": 8900,
  "Kubernetes": {
    "KubeConfigFileName": "",
    "UseDefaultContext": true,
    "NamespaceList": ""
  },
  "EnabledTrivyReports":{
    "ClusterComplianceReport": true,
    "ClusterConfigAuditReport": true,
    "ClusterInfraAssessmentReport": true,
    "ClusterRbacAssessmentReport": true,
    "ClusterSbomReport": true,
    "ClusterVulnerabilityReport": true,
    "ConfigAuditReport": true,
    "ExposedSecretReport": true,
    "InfraAssessmentReport": true,
    "RbacAssessmentReport": true,
    "SbomReport": true,
    "VulnerabilityReport": true
  },
  "FileExport": {
    "TempFolder": null
  },
  "Queues": {
    "Capacity": 5000
  },
  "Watchers": {
    "WatchTimeoutInSeconds": 600,
    "FilterWatchersWithNoActivity": true,
    "MaxConcurrentInitialLists": 2
  },
  "FileRepository": {
    "BasePath": "",
    "ClusterComplianceReportCrSubpath": "",
    "ClusterConfigAuditReportCrSubpath": "",
    "ClusterInfraAssessmentReportCrSubpath": "",
    "ClusterRbacAssessmentReportCrSubpath": "",
    "ClusterSbomReportCrSubpath": "cluster_sbom_reports",
    "ClusterVulnerabilityReportCrSubpath": "cluster_vulnerability_reports",
    "ConfigAuditReportCrSubpath": "",
    "ExposedSecretReportCrSubpath": "secret_reports",
    "InfraAssessmentReportCrSubpath": "",
    "RbacAssessmentReportCrSubpath": "",
    "SbomReportCrSubpath": "sbom_reports",
    "VulnerabilityReportCrSubpath": "vulnerability_reports"
  },
  "History": {
    "Enabled": true,
    "Retention": {
      "RunIntervalInMinutes": 30,
      "KeepDays": 14,
      "KeepLast": 2
    },
    "DistributedCache": {
      "ConnectionString": "192.168.85.3:6379,ssl=False,abortConnect=False",
      "RetryOptions": {
        "MaxRetries": 5,
        "InitialDelay": "50ms",
        "MaxDelay": "1s"
      }
    }
  },
  "InMemoryCache": {
    "ExpireInMinutes": 10
  },
  "GitHub": {
    "BaseTrivyDashboardRepoUrl": "https://api.github.com/repos/raoulx24/trivy-operator-dashboard",
    "BaseTrivyOperatorRepoUrl": "https://api.github.com/repos/aquasecurity/trivy-operator",
    "ServerCheckForUpdates": true,
    "CheckForUpdatesIntervalInMinutes": 360
  },
  "EndOfLife": {
    "Enabled": true,
    "BaseUrl": "https://endoflife.date/api/v1",
    "ProcessingIntervalInSeconds": 60,
    "ProductTtlInMinutes": 1440,
    "NotFoundTtlInMinutes": 1440,
    "ErrorTtlInMinutes": 15,
    "RequestTimeoutInSeconds": 30,
    "ProductMappingsFile": ""
  },
  "CveEnrichment": {
    "Enabled": true,
    "SweepAgeInHours": 48,
    "HousekeepingIntervalInSeconds": 300,
    "Kev": {
      "Enabled": true,
      "Url": "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json",
      "ProcessingIntervalInSeconds": 60,
      "RefreshIntervalInMinutes": 360,
      "ErrorTtlInMinutes": 15,
      "RequestTimeoutInSeconds": 60
    },
    "Epss": {
      "Enabled": true,
      "BaseUrl": "https://api.first.org/data/v1",
      "ProcessingIntervalInSeconds": 60,
      "EntryTtlInMinutes": 1440,
      "BatchSize": 100,
      "ErrorTtlInMinutes": 15,
      "RequestTimeoutInSeconds": 30
    },
    "Euvd": {
      "Enabled": true,
      "BaseUrl": "https://euvdservices.enisa.europa.eu/api",
      "ProcessingIntervalInSeconds": 60,
      "RefreshIntervalInMinutes": 360,
      "PageSize": 100,
      "ErrorTtlInMinutes": 15,
      "RequestTimeoutInSeconds": 30
    }
  },
  "OpenTelemetry": {
    "Enabled": true,
    "OtelEndpoint": "",
    "ConsoleEnabled": false,
    "AspNetCoreInstrumentationEnabled": true,
    "RuntimeInstrumentationEnabled": true,
    "OtelProtocol": "grpc",
    "HistogramBoundsInMs": [
      200,
      500,
      1000,
      5000
    ],
    "PrometheusExporterPort": 8901
  }
}
